{
  "name": "awh-hospital-automation",
  "version": "1.0.0",
  "description": "Enterprise Playwright Automation Framework for AWH Hospital Website Booking Form with Page Object Model and Allure reporting.",
  "main": "index.js",
  "scripts": {
    "test": "rimraf allure-results && playwright test",
    "test:dev": "rimraf allure-results && ENV=dev playwright test",
    "test:uat": "rimraf allure-results && ENV=uat playwright test",
    "test:staging": "rimraf allure-results && ENV=staging playwright test",
    "report:html": "playwright show-report",
    "report:generate": "node scripts/save-history.js && allure generate allure-results --clean -o allure-report && node scripts/send-email-report.js",
    "report:open": "allure open allure-report",
    "report:allure": "npm run report:generate && npm run report:open"
  },
  "dependencies": {
    "@playwright/test": "^1.20.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.4",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.4.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "page-object-model",
    "allure"
  ],
  "author": "guna",
  "license": "MIT"
}
