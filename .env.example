# ============================================================
# AWH Hospital Automation Framework - Environment Configuration
# ============================================================
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to version control! (It is safely in .gitignore)
# ============================================================

# ---- EMAIL REPORTING ----
# Enable or disable email reporting (true/false)
SEND_EMAIL_REPORT=true

# SMTP Server details (For Gmail: smtp.gmail.com, Port: 465, Secure: true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your Gmail address and App Password
# How to get App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=puttuguna123@gmail.com
SMTP_PASS=ceus gnaw yqax rcvx

# Recipients (comma-separated if multiple)
EMAIL_TO=gunasekhar.puttu@forgebyte.ai, team@company.com

# ---- GITHUB ----
# Personal Access Token for git push
# How to get: https://github.com/settings/tokens → Generate new token (classic) → check "repo"
GITHUB_PAT=ghp_paste_your_token_here
GITHUB_REPO=AWH-ai/Awh-Hospital

# ---- JENKINS (Local Setup) ----
# Initial admin password found at: C:\Users\gunasekhar.p\.jenkins\secrets\initialAdminPassword
JENKINS_INITIAL_ADMIN_PASSWORD=e0b923ad1cb04cc495f9e15a1b257851
JENKINS_USERNAME=Gunasekhar
JENKINS_PASSWORD=Guna@2000
